{
  "name": "@linkiez/nfe-sdk",
  "version": "1.0.1",
  "description": "TypeScript SDK for NFe, NFCe, and Manifestacao do Destinatario XSD schemas.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linkiez/nfe_sdk.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "clean": "rm -rf dist .xsd2ts-work",
    "generate": "tsx tools/generate.ts",
    "download:official-docs": "tsx tools/download-official-docs.ts",
    "download:official-page-assets": "tsx tools/download-official-page-assets.ts",
    "convert:official-docs": "tsx tools/convert-official-docs.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write README.md .github/copilot-instructions.md .github/workflows/**/*.yml eslint.config.mjs jest.config.ts package.json tsconfig.json tsconfig.build.json docs/**/*.md examples/**/*.ts src/**/*.doc.md tests/**/*.ts tests/**/*.json tools/**/*.ts specs/003-public-package-contract/**/*.md specs/004-iniciar-sdk/**/*.md specs/005-add-digital-signing/**/*.md specs/006-add-soap-transport/**/*.md specs/013-release-hardening/**/*.md",
    "format:check": "prettier --check README.md .github/copilot-instructions.md .github/workflows/**/*.yml eslint.config.mjs jest.config.ts package.json tsconfig.json tsconfig.build.json docs/**/*.md examples/**/*.ts src/**/*.doc.md tests/**/*.ts tests/**/*.json tools/**/*.ts specs/003-public-package-contract/**/*.md specs/004-iniciar-sdk/**/*.md specs/005-add-digital-signing/**/*.md specs/006-add-soap-transport/**/*.md specs/013-release-hardening/**/*.md",
    "docs:links": "tsx tools/validate-links-comprehensive.ts",
    "docs:links:default": "tsx tools/validate-links-default.ts",
    "docs:links:custom": "tsx tools/validate-links-custom.ts",
    "docs:links:nf": "tsx tools/validate-links-nf.ts",
    "docs:check": "npm run format:check && npm run docs:links",
    "test": "jest --runInBand",
    "sync:local": "node scripts/sync-local-package.mjs",
    "sync:local:skip-build": "node scripts/sync-local-package.mjs --skip-build",
    "sync:local:revert": "node scripts/sync-local-package.mjs --revert",
    "audit:public-contract": "tsx tools/audit-public-contract.ts",
    "validate:tarball": "tsx tools/validate-package-tarball-cli.ts"
  },
  "keywords": [
    "nfe",
    "nfce",
    "manifestacao-do-destinatario",
    "xsd",
    "typescript",
    "esm"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "1.5.5",
    "@zxing/library": "0.21.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.9",
    "sharp": "0.35.5",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "xsd2ts": "^0.9.17"
  },
  "dependencies": {
    "@types/node-forge": "^1.3.14",
    "@xmldom/xmldom": "^0.9.12",
    "node-forge": "^1.4.3",
    "node-sped-pdf": "1.0.66",
    "qrcode": "1.5.4",
    "xml-crypto": "^6.1.2"
  }
}
